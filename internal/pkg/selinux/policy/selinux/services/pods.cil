(type pod_file_t)
(call system_f (pod_file_t))
(allow pod_file_t self (filesystem (associate)))
(allow pod_file_t tmpfs_t (filesystem (associate)))
(allow pod_p pod_file_t (fs_classes (rw)))
(allow pod_containerd_t pod_file_t (fs_classes (rw)))
(allow pod_containerd_t pod_file_t (fs_classes (relabelfrom relabelto)))
(allow pod_containerd_t pod_file_t (file (execute execute_no_trans)))
(allow pod_containerd_t fs_t (filesystem (relabelfrom)))
(allow pod_containerd_t tmpfs_t (fs_classes (relabelfrom)))
(allow pod_containerd_t devpts_t (filesystem (relabelfrom)))
(allow pod_containerd_t kubelet_state_t (fs_classes (relabelfrom)))
(typealias container_file_t)
(typealiasactual container_file_t pod_file_t)
(allow kubelet_t kubelet_state_t (fs_classes (relabelfrom)))
(allow kubelet_t pod_file_t (fs_classes (relabelfrom relabelto)))
; A volume a CSI driver formatted, or filled before the CRI labeled containers, holds unlabeled_t files until the
; kubelet applies the fsGroup of the pod and the CRI relabels them for its categories.
(allow pod_containerd_t unlabeled_t (fs_classes (relabelfrom)))
(allow kubelet_t unlabeled_t (dir (getattr search open read setattr)))
(allow kubelet_t unlabeled_t (file (getattr setattr)))
(allow kubelet_t unlabeled_t (lnk_file (getattr setattr)))
; A hugepages volume: the CRI labels the hugetlbfs mount, and the pod creates its pages in it.
(allow pod_containerd_t hugetlbfs_t (fs_classes (relabelfrom)))
(allow pod_file_t hugetlbfs_t (filesystem (associate)))

; Kubernetes workloads: pod_t and every pod domain below. Whatever a domain is granted, these hold: no STATE, no
; system socket, no connection to machined, no ptrace of a host service.
(typeattribute workload_p)
(neverallow workload_p system_state_t (file (read write)))
(neverallow workload_p system_socket_f (sock_file (write)))
(neverallow workload_p init_t (unix_stream_socket (connectto)))
(neverallow workload_p system_p (process (ptrace)))
; Every domain the CRI starts is a workload, the system services it runs aside, and a workload enters no other domain.
(typeattribute not_cri_workload_p)
(typeattributeset not_cri_workload_p (not (or workload_p (or pod_containerd_t (or kubelet_t (or etcd_t (or taloscontainer_t taloscontainer_machined_t)))))))
(neverallow pod_containerd_t not_cri_workload_p (process (transition dyntransition)))
(typeattribute not_workload_p)
(typeattributeset not_workload_p (not workload_p))
(neverallow workload_p not_workload_p (process (transition dyntransition)))
; A workload that mounts the host /dev does not log into the syslog of machined through /dev/log, and is not audited for
; trying, as storage daemons do at every start.
(dontaudit workload_p init_t (unix_dgram_socket (sendto)))
; A workload that scans /proc, as the health scripts of Kafka do, meets the runc process of an exec probe in its pod:
; reading it stays denied and is not audited.
(dontaudit workload_p pod_containerd_t (dir (getattr search)))
(dontaudit workload_p pod_containerd_t (file (getattr open read)))
(dontaudit workload_p pod_containerd_t (lnk_file (getattr read)))

; Booleans narrow what a regular pod may do. They default to the rights pods had before they existed. Each one grants a
; right below to pod_t, and the domains that need the right have it whatever the boolean says.
; Write and run the CNI plugins in /opt/cni/bin, the way CNI installers do.
(boolean pod_write_cni_plugins true)
; Read and write the network filesystems (NFS, CIFS) mounted as volumes.
(boolean pod_use_network_fs true)
; Open perf events and pin eBPF objects in bpffs.
(boolean pod_use_ebpf true)

; CNI installers copy their plugins, and `install` also runs them.
(macro pod_cni_plugins_right ((type ARG1))
    (allow ARG1 cni_plugin_t (fs_classes (rw)))
    (allow ARG1 cni_plugin_t (file (execute execute_no_trans)))
)

; Network filesystems are labeled network_fs_t by genfscon. The filesystem and the mount options still enforce read-only
; and Unix-level access controls.
(macro pod_network_fs_right ((type ARG1))
    (allow ARG1 network_fs_t (fs_classes (rw)))
)

(macro pod_ebpf_right ((type ARG1))
    (allow ARG1 self (perf_event (all)))
    (allow ARG1 bpf_t (fs_classes (rw)))
)

; What every pod domain shares: it is a workload, entered from the rootfs of its container.
(macro pod_workload ((type ARG1))
    (call pod_p (ARG1))
    (typeattributeset workload_p ARG1)
    ; the rootfs of the container, pod_file_t when the CRI labels containers
    (allow ARG1 pod_file_t (file (entrypoint)))
    ; nsenter from Cilium's apply-sysctl-overwrites
    ; Actually does not find sysctl directories and exits
    (allow ARG1 sandboxd_t (fs_classes (ro)))
)

; The rights of a regular pod, which the booleans narrow: pod_t is built on this macro.
(macro pod_domain ((type ARG1))
    (call pod_workload (ARG1))
    (booleanif pod_write_cni_plugins (true (call pod_cni_plugins_right (ARG1))))
    (booleanif pod_use_network_fs (true (call pod_network_fs_right (ARG1))))
    (booleanif pod_use_ebpf (true (call pod_ebpf_right (ARG1))))
)

(typeattribute privileged_readable_f)
(typeattributeset privileged_readable_f (and any_f (not (or protected_f (or protected_device_f (or system_socket_f unlabeled_t))))))

; Host access: it reads the host files and the /proc of every domain, writes /run, ignores the MCS categories, and pods
; may connect to its sockets.
(macro pod_host_domain ((type ARG1))
    (call pod_workload (ARG1))
    (typeattributeset mcs_exempt_p ARG1)
    (allow ARG1 privileged_readable_f (fs_classes (ro)))
    (allow ARG1 any_p (fs_classes (ro)))
    (allow ARG1 run_t (fs_classes (rw)))
    (allow pod_p ARG1 (unix_stream_socket (connectto)))
)

; Network rights: the CNI plugins a CNI agent installs and runs, perf events, bpffs, and the BPF programs runc attaches
; to the cgroups of containers, which Cilium reads.
(macro pod_network_rights ((type ARG1))
    (call pod_cni_plugins_right (ARG1))
    (call pod_ebpf_right (ARG1))
    (allow ARG1 pod_containerd_t (bpf (prog_run)))
    (allow ARG1 sys_containerd_t (bpf (prog_run)))
)

; Storage rights: the network filesystems, semctl(IPC_INFO) from lvm, io_uring with a polling kernel thread and the
; commands SPDK and ublk pass to the devices, the sysfs settings of virtual storage devices (block queues, NVMe over
; fabrics controllers and multipath), and xfs_growfs on the staged mount of a volume, whose root is unlabeled until the
; CRI labels it for a pod. Physical disks and the rest of sysfs stay read-only.
(macro pod_storage_rights ((type ARG1))
    (call pod_network_fs_right (ARG1))
    (allow ARG1 kernel_t (system (ipc_info)))
    (allow ARG1 self (io_uring (allowed sqpoll)))
    (allow ARG1 common_device_f (io_uring (cmd)))
    (allow ARG1 sys_storage_t (file (open write)))
    ; sysfs creates no file: opening the queue setting of a device the kernel has not published yet is not audited
    (dontaudit ARG1 sys_storage_t (dir (write add_name)))
    (dontaudit ARG1 sys_storage_t (file (create)))
    (allow ARG1 unlabeled_t (dir (getattr search open read ioctl)))
)

; A CNI agent: the host access and the network rights.
(macro pod_cni_domain ((type ARG1))
    (call pod_host_domain (ARG1))
    (call pod_network_rights (ARG1))
)

; A CSI node plugin: the host access and the storage rights.
(macro pod_csi_domain ((type ARG1))
    (call pod_host_domain (ARG1))
    (call pod_storage_rights (ARG1))
)

; A privileged container: the host access and the rights of both roles, since it may run either agent.
(macro pod_privileged_domain ((type ARG1))
    (call pod_host_domain (ARG1))
    (call pod_network_rights (ARG1))
    (call pod_storage_rights (ARG1))
)

; A process monitor or a log forwarder: it reads /proc, the logs and the files of every pod across MCS categories, writes
; none of them, and opens perf events.
(macro pod_hostmon_domain ((type ARG1))
    (call pod_workload (ARG1))
    (typeattributeset mcs_read_exempt_p ARG1)
    (allow ARG1 any_p (fs_classes (ro)))
    (allow ARG1 self (perf_event (all)))
    (allow ARG1 bpf_t (fs_classes (ro)))
)

; Domains a pod or a container selects with seLinuxOptions.type. pod_netfs_t and pod_ebpf_t are regular pods that keep
; one right whatever its boolean says, for the workloads that need it once the boolean takes it from the other pods: no
; host access, and the MCS categories still apply. The other domains are for the roles that would otherwise run
; privileged: a CNI agent or a CSI node plugin gets the host access of a privileged container and the rights of its
; role, without `privileged: true` and its devices and capabilities.
(type pod_netfs_t)
(call pod_domain (pod_netfs_t))
(call pod_network_fs_right (pod_netfs_t))
(type pod_ebpf_t)
(call pod_domain (pod_ebpf_t))
(call pod_ebpf_right (pod_ebpf_t))
(type pod_hostmon_t)
(call pod_hostmon_domain (pod_hostmon_t))
(type pod_cni_t)
(call pod_cni_domain (pod_cni_t))
(type pod_csi_t)
(call pod_csi_domain (pod_csi_t))

; containerd clears the label of a privileged container, which then enters pod_privileged_t from its pod_file_t rootfs
(type pod_privileged_t)
(call pod_privileged_domain (pod_privileged_t))
(typetransition pod_containerd_t pod_file_t process pod_privileged_t)
(typealias spc_t)
(typealiasactual spc_t pod_privileged_t)
