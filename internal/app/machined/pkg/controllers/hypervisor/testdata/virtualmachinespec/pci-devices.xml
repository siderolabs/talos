<domain type="kvm">
  <name>pci-devices</name>
  <memory unit="bytes">4294967296</memory>
  <vcpu>3</vcpu>
  <resource>
    <partition>/virtualmachines.partition</partition>
  </resource>
  <os firmware="efi">
    <type arch="x86_64" machine="q35">hvm</type>
    <firmware>
      <feature enabled="no" name="secure-boot"></feature>
      <feature enabled="no" name="enrolled-keys"></feature>
    </firmware>
  </os>
  <features>
    <acpi></acpi>
  </features>
  <cpu mode="host-model"></cpu>
  <clock offset="utc">
    <timer name="pit" tickpolicy="discard"></timer>
  </clock>
  <devices>
    <channel type="unix">
      <source mode="bind"></source>
      <target type="virtio" name="org.qemu.guest_agent.0"></target>
    </channel>
    <hostdev mode="subsystem" type="pci" managed="no">
      <driver name="vfio"></driver>
      <source>
        <address domain="0x0000" bus="0x41" slot="0x00" function="0x0"></address>
      </source>
      <boot order="1"></boot>
      <alias name="ua-pci-0000-41-00-0"></alias>
    </hostdev>
    <hostdev mode="subsystem" type="pci" managed="no">
      <driver name="vfio"></driver>
      <source>
        <address domain="0x0000" bus="0x41" slot="0x00" function="0x1"></address>
      </source>
      <alias name="ua-pci-0000-41-00-1"></alias>
    </hostdev>
    <hostdev mode="subsystem" type="pci" managed="no">
      <driver name="vfio"></driver>
      <source>
        <address domain="0x0001" bus="0xaf" slot="0x1f" function="0x7"></address>
      </source>
      <alias name="ua-pci-0001-af-1f-7"></alias>
    </hostdev>
    <memballoon model="none"></memballoon>
  </devices>
</domain>
