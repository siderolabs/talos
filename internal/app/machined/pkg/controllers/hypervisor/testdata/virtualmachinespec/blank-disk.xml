<domain type="kvm">
  <name>booted</name>
  <memory unit="bytes">4294967296</memory>
  <vcpu>3</vcpu>
  <resource>
    <partition>/virtualmachines.partition</partition>
  </resource>
  <os firmware="efi">
    <type>hvm</type>
    <firmware>
      <feature enabled="no" name="secure-boot"></feature>
      <feature enabled="no" name="enrolled-keys"></feature>
    </firmware>
  </os>
  <features>
    <acpi></acpi>
  </features>
  <cpu mode="host-model"></cpu>
  <devices>
    <disk type="file" device="disk">
      <driver name="qemu" type="qcow2" error_policy="stop" rerror_policy="stop"></driver>
      <source file="/storage-pool/booted__data.qcow2"></source>
      <target dev="vda" bus="virtio"></target>
      <boot order="1"></boot>
    </disk>
    <channel type="unix">
      <source mode="bind"></source>
      <target type="virtio" name="org.qemu.guest_agent.0"></target>
    </channel>
    <memballoon model="none"></memballoon>
  </devices>
</domain>
