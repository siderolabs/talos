<domain type="kvm">
  <name>guest-one</name>
  <memory unit="bytes">4294967296</memory>
  <vcpu>3</vcpu>
  <cputune>
    <global_period>100000</global_period>
    <global_quota>250000</global_quota>
  </cputune>
  <resource>
    <partition>/virtualmachines.partition</partition>
  </resource>
  <os firmware="efi">
    <type>hvm</type>
    <firmware>
      <feature enabled="no" name="secure-boot"></feature>
      <feature enabled="no" name="enrolled-keys"></feature>
    </firmware>
  </os>
  <features>
    <acpi></acpi>
  </features>
  <cpu mode="host-model"></cpu>
  <devices>
    <memballoon model="none"></memballoon>
  </devices>
</domain>
